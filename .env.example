# Mandatory credentials. Use a strong password; basic auth requires HTTPS outside a trusted LAN.
APP_USERNAME=admin
APP_PASSWORD=
# For Synology set these to the UID/GID that can write to the target USB volume.
PUID=1026
PGID=100
# Optional supplementary group for DSM ACL access.
# On a Synology where a shared folder grants access to administrators, set 101.
# This grants the container the corresponding group permissions on mounted paths.
NAS_EXTRA_GID=100
PORT=8088
TZ=Europe/Paris
