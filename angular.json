{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "network-sync": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "web",
      "prefix": "ns",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "index": "web/index.html",
            "browser": "web/main.ts",
            "tsConfig": "tsconfig.web.json",
            "styles": ["web/styles.css"],
            "assets": [{"glob": "**/*", "input": "web/assets", "output": "/"}]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {"type": "initial", "maximumWarning": "750kB", "maximumError": "2MB"}
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"buildTarget": "network-sync:build"}
        }
      }
    }
  },
  "defaultProject": "network-sync"
}
