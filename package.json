{
  "name": "network-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "ng build --configuration production",
    "start": "node dist/server/server.js",
    "test": "npm run build:api && node --test dist/server/*.test.js",
    "dev:api": "tsx watch server/server.ts",
    "dev:web": "ng serve --host 0.0.0.0"
  },
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "express": "^4.21.2",
    "node-cron": "^4.2.1",
    "rxjs": "^7.8.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
